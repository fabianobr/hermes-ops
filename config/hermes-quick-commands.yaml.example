# Merge into ~/.hermes/config.yaml on the host.
# Validation:
#   hermes config show | rg -n 'quick_commands|check-system|check_system'
#   hermes config show | rg -n 'start-comfyui|start_comfyui'

quick_commands:
  check-system:
    type: exec
    command: bash ~/AI/hermes-ops/scripts/check_system_resources.sh
  check_system:
    type: exec
    command: bash ~/AI/hermes-ops/scripts/check_system_resources.sh
  # start-comfyui waits for the container health check, so it can take up to
  # COMFYUI_START_TIMEOUT seconds (default 90) to answer in Telegram.
  start-comfyui:
    type: exec
    command: bash ~/AI/hermes-ops/scripts/start_comfyui.sh
  start_comfyui:
    type: exec
    command: bash ~/AI/hermes-ops/scripts/start_comfyui.sh
